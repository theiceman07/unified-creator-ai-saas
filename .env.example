# ================= CreatorOS .env.example =================
# Copy to .env (never commit .env). Placeholders only.

# ---- App ----
APP_ENV=dev                         # dev | demo | eval | prod
API_BASE_URL=http://localhost:8000
WEB_BASE_URL=http://localhost:3000
DEMO_MODE=true                      # enables /v1/demo/login + fixture fallback when providers fail
OFFLINE_FALLBACK=true               # label fixture outputs as "offline draft"
CORS_ORIGINS=http://localhost:3000

# ---- Database / Supabase ----
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/creatoros
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here      # server only
SUPABASE_JWT_SECRET=your_jwt_secret_here
STORAGE_BUCKET=creatoros-uploads

# ---- Queue / cache ----
REDIS_URL=redis://localhost:6379/0
QUEUE_BACKEND=redis                 # redis | postgres (fallback)
LLM_CACHE_TTL_S=86400

# ---- LLM providers (fill what you have; gateway skips missing ones) ----
GEMINI_API_KEY=your_gemini_key_here
ANTHROPIC_API_KEY=your_anthropic_key_here
OPENAI_API_KEY=your_openai_key_here
GROQ_API_KEY=your_groq_key_here
OLLAMA_BASE_URL=http://localhost:11434

# ---- Model tiers: ordered fallback list "provider:model_name" ----
# Use current model names from each provider's docs.
LLM_TIER_FAST=gemini:<flash-class-model>,groq:<fast-model>
LLM_TIER_STANDARD=gemini:<pro-or-flash-model>,anthropic:<sonnet-class-model>
LLM_TIER_REASONING=anthropic:<sonnet-or-opus-class-model>,gemini:<pro-model>
LLM_TIER_JUDGE=anthropic:<sonnet-class-model>,openai:<model>      # prefer a different family than generators
LLM_TIMEOUT_FAST_S=15
LLM_TIMEOUT_STANDARD_S=45
LLM_TIMEOUT_REASONING_S=90

# ---- Embeddings (ONE model, ONE dimension platform-wide; must match schema.sql vector(768)) ----
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=<embedding-model-name>
EMBEDDING_DIM=768

# ---- Tools ----
WEB_SEARCH_PROVIDER=tavily          # tavily | serper | brave
WEB_SEARCH_API_KEY=your_search_key_here
TRANSCRIBE_BACKEND=faster_whisper   # faster_whisper | api | none
WHISPER_MODEL_SIZE=small
CLIP_SERVICE_URL=                   # set if #06 runs as a remote capability

# ---- Tracing / evals ----
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=your_langsmith_key_here
LANGSMITH_PROJECT=creatoros-dev
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# ---- Judge policy ----
JUDGE_SAMPLE_RATE_QUICK=0.3
JUDGE_ALWAYS_IN_CAMPAIGN=script,copy,hook
JUDGE_PASS_THRESHOLD_DEFAULT=3.6
JUDGE_MAX_REPAIRS=1

# ---- Limits ----
RATE_LIMIT_CAMPAIGNS_PER_HOUR=20
MAX_UPLOAD_MB_MEDIA=500
MAX_UPLOAD_MB_DOCS=20

# ---- Frontend (apps/web/.env.local) ----
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
NEXT_PUBLIC_DEMO_MODE=true
NEXT_PUBLIC_LANGSMITH_PROJECT_URL=https://smith.langchain.com/o/<org>/projects/p/<id>
